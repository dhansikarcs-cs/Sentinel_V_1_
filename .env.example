# ── Required/important ───────────────────────────────────────────────
# JWT signing secret — MUST be a long random string in production
JWT_SECRET=change-me-in-production-use-a-real-secret

# Database: SQLite for local dev; PostgreSQL for scaled deploys
#   sqlite:///./data/sentinel.db
#   postgresql://user:pass@host:5432/sentinel
DATABASE_URL=sqlite:///./data/sentinel.db

# ── Email (Gmail SMTP) — use a Gmail app password ───────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=Sentinel <your_email@gmail.com>
CRISIS_HELPLINE_EMAIL=your_helpline@gmail.com

# Crisis trusted contact link (set absolute URL for Render/production)
SENTINEL_ACK_LINK=https://your-app.onrender.com/trustee
TRUSTEE_LINK_SECRET=change-me

# ── AI ───────────────────────────────────────────────────────────────
# Groq API — free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
ALLOW_CLOUD_AI=false
# Ollama (local) — override for Docker/Host networking
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=sentinel

# ── Encryption (journals at rest) ────────────────────────────────────
# 16-byte hex salt (32 hex chars). Leave empty to auto-generate on first run —
# but then SAVE the value so decrypts work after restarts.
ENCRYPTION_SALT=
ENCRYPTION_PASSPHRASE=your_long_passphrase
ENCRYPTION_REQUIRED=true

# ── Web ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false          # true behind HTTPS

# ── Scaling ──────────────────────────────────────────────────────────
# Rate limiter: memory (single process) or db (shared via DATABASE_URL)
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=60
# Set RUN_WORKERS=false on API processes when a dedicated scheduler runs the loops;
# leave true for a plain single-process local run.
RUN_WORKERS=true
# WebSocket fan-out: auto (PG LISTEN/NOTIFY when DATABASE_URL is postgres),
# pg (force), or off (single-process local broadcast only)
WS_PUBSUB=auto
# Scheduler leader election (PostgreSQL). Multiple scheduler replicas are safe;
# exactly one runs the loops. The lock key must match across replicas.
SCHEDULER_LOCK_KEY=749493
SCHEDULER_HEARTBEAT_SECONDS=10
# Connection pooling (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800