# Email (Gmail SMTP) — use Gmail app password
SENTINEL_EMAIL=your_email@gmail.com
SENTINEL_EMAIL_PASSWORD=your_app_password
SENTINEL_RECEIVER=your_email@gmail.com

# Crisis trusted contact link (auto-detects port if empty — set for Render/production)
SENTINEL_ACK_LINK=https://your-app.onrender.com/trustee

# Groq AI API — free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Encryption key (auto-generated if empty)
SENTINEL_ENCRYPTION_KEY=

# Encryption passphrase for journals at rest (must match across workers/restarts)
SENTINEL_ENCRYPTION_PASSPHRASE=

# Scaling
# Rate limiter backend: memory (single process) or db (shared via DATABASE_URL)
RATE_LIMIT_BACKEND=memory
# Set RUN_WORKERS=false on API processes when a dedicated scheduler runs the loops;
# leave true for a plain single-process local run.
RUN_WORKERS=true
# Connection pooling (PostgreSQL/MySQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
